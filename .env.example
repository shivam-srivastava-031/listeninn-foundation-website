# ── Server-side only. NOT exposed to the browser. ──
# The AI chat is proxied through /api/gemini (a Vercel serverless function),
# which reads this key on the server so it never ships in the client bundle.
#
# Get a Gemini API key at https://aistudio.google.com/app/apikey
# The Google project MUST have quota/billing enabled or calls return 429.
#
# In Vercel: Settings → Environment Variables → add GEMINI_API_KEY (do NOT use
# the VITE_ prefix — that would expose it to the browser). Then redeploy.
GEMINI_API_KEY=

# Optional — override the model (defaults to gemini-2.0-flash).
# GEMINI_MODEL=gemini-2.0-flash


# ── Editable Counseling page (admin panel → "Counseling Page" tab) ──
# The counseling details (therapists, credentials, charges, sliding scale) are
# stored in Supabase so admin edits are visible to ALL visitors. Served/saved via
# the /api/counseling serverless function. The service-role key is SERVER-SIDE
# only — never shipped to the browser.
#
# 1) Create a Supabase project (free tier) at https://supabase.com, then in the
#    SQL editor run:
#      create table if not exists site_content (
#        key text primary key,
#        value jsonb not null,
#        updated_at timestamptz default now()
#      );
#
# 2) In Supabase → Project Settings → API, copy the Project URL and the
#    service_role key (NOT the anon key). Add them in Vercel (no VITE_ prefix):
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
#
# 3) Set the admin-panel password used to authorise saves. This MUST match the
#    password typed into the admin login. NOT public (no VITE_ prefix).
#    Use your own strong value here — do not commit a real password.
ADMIN_PANEL_PASSWORD=
#
# Until Supabase is configured, the counseling page still works — it shows the
# built-in "details coming soon" defaults, and saving reports it's not set up.
